# Audema AdForge MCP — environment configuration
# Copy this file to .env and fill in the values you need.

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory where brand profiles, ad briefs, concepts, and campaign results
# are persisted as JSON files. Defaults to ./data if not set.
ADFORGE_DATA_DIR=./data

# Directory where exported PNG/JPG ad creative is written. Defaults to ./exports.
ADFORGE_EXPORT_DIR=./exports

# ── Optional: background visual generation ──────────────────────────────────
# Set ADFORGE_IMAGE_PROVIDER (below) and the matching key to let export_ad_image
# generate a background from a `backgroundPrompt` instead of a flat/gradient
# brand-colour background. Leave ADFORGE_IMAGE_PROVIDER=none to skip — static
# ads still render correctly with solid or gradient backgrounds either way,
# and passing backgroundPrompt with no provider configured fails loudly
# rather than silently falling back.

# Which provider to use. One of: none | openai | replicate
ADFORGE_IMAGE_PROVIDER=none

# OpenAI — used for gpt-image-1 background generation. This is the SAME
# environment variable name the main Audema web app uses (api/openai.js) —
# if you already have that key set up for the live product, reuse the same
# value here; this server only ever runs locally, never on Vercel.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Replicate — alternative background image provider (Flux, SDXL, etc.)
REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# ── Spend guardrail (applies regardless of platform credentials) ───────────
# Hard ceiling on create_campaign_draft's dailyBudgetCents, enforced
# server-side — a request above this is REJECTED, never silently reduced.
# Applies even when no platform is configured, since the local-only draft
# still records the requested amount. Default: 10000 ($100/day).
ADFORGE_MAX_DAILY_BUDGET_CENTS=10000

# ── Optional: real platform campaign creation (PAUSED/draft only) ──────────
# create_campaign_draft ALWAYS creates campaigns in a paused state — there is
# no code path in this server that can publish an active, spending campaign.
# Without credentials below, drafts are saved locally only (still fully
# useful for planning) and never reach the platform.
#
# Meta is the only platform implemented so far — LinkedIn/TikTok drafts
# always save locally until those adapters are built. The Meta adapter's
# request shape follows Meta's published Marketing API docs but has not
# been exercised against a real ad account in this codebase — test it
# against a real (low/zero-budget) campaign before trusting it for spend.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# META_API_VERSION=v21.0

# ── Optional: hosted export URLs (Cloudflare R2) ────────────────────────────
# export_ad_image/export_ad_image_all_sizes always write to local disk
# regardless — this only additionally uploads the rendered file to the SAME
# shared R2 bucket the main Audema web app uses (under an "adforge/" prefix),
# so exported creative can be handed off to a publish flow that needs a real
# fetchable URL, not a local file path. Uses hand-rolled AWS SigV4 signing
# (Node's built-in crypto — no aws-sdk dependency), since R2 exposes an
# S3-compatible API. Without these set, exports simply stay local-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# A custom domain or the bucket's r2.dev URL — without this, uploads still
# succeed but no hosted URL is returned (the raw S3 API endpoint isn't public)
# R2_PUBLIC_BASE_URL=
