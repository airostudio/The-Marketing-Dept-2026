{
  "name": "audema-adforge-mcp",
  "version": "1.0.0",
  "description": "Audema AdForge MCP — generate high-converting static ad concepts, copy, layouts, and production-ready PNG/JPG creative for Audema Marketing clients.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "audema-adforge-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && node scripts/smoke-test.mjs",
    "test:all": "npm run test && npm run test:e2e"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  },
  "license": "UNLICENSED",
  "private": true
}
