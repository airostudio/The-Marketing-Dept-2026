# ═══════════════════════════════════════════════════════════════════════════════
# AUDEMA ENVIRONMENT VARIABLES — Example Configuration
# Copy this file to .env for local development
# For Vercel deployment, add these to Vercel Dashboard → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# Claude API Key (Required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api-your-key-here

# Node Environment
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════════════════════
# NANCY "JAM FANCY" — AI Instagram Content Research & Generation Studio
# Reuses ANTHROPIC_API_KEY above, plus SUPABASE_URL/SUPABASE_ANON_KEY/
# SUPABASE_SERVICE_ROLE_KEY already required elsewhere in this app (Settings
# page, or Vercel env vars). New/optional vars below.
# ═══════════════════════════════════════════════════════════════════════════════

# Live web research for competitor/market discovery (Perplexity Sonar — real
# search with citations). Without this, Nancy still works using the target
# website alone; the market-research step is skipped with a clear note.
PERPLEXITY_API_KEY=pplx-your-key-here

# Live website screenshot capture. Without this, brand colours are still
# extracted from the site's raw HTML/CSS — just no screenshot to show.
# SCREENSHOT_PROVIDER selects the adapter: "screenshotone" (default) or "browserless".
SCREENSHOT_API_KEY=
SCREENSHOT_PROVIDER=screenshotone
BROWSERLESS_ENDPOINT=https://chrome.browserless.io

# Optional hosted-URL storage for generated graphics/screenshots (Cloudflare
# R2). Without this, Supabase Storage is used as a fallback for user photos,
# and generated graphics are returned as data URIs only (still fully
# downloadable — just no public hosted URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Background/illustration image generation (never used for exact text — see
# api/_lib/nancy-providers.js). Not yet wired to a concrete provider; adding
# a key alone does nothing until a provider implementation is added there.
IMAGE_GEN_API_KEY=
