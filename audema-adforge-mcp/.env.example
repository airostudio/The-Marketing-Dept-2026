# Audema AdForge MCP — environment configuration
# Copy this file to .env and fill in the values you need.

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory where brand profiles, ad briefs, concepts, and campaign results
# are persisted as JSON files. Defaults to ./data if not set.
ADFORGE_DATA_DIR=./data

# Directory where exported PNG/JPG ad creative is written. Defaults to ./exports.
ADFORGE_EXPORT_DIR=./exports

# ── Optional: background visual generation ──────────────────────────────────
# If set, export_ad_image can request an AI-generated background image instead
# of a flat/gradient brand-colour background. Leave blank to skip — static
# ads will still render correctly with solid or gradient backgrounds.

# OpenAI (used for gpt-image-1 background generation)
OPENAI_API_KEY=

# Replicate (alternative background image provider — e.g. Flux, SDXL)
REPLICATE_API_TOKEN=

# Which provider to use when a concept's visualDirection implies a photographic
# or illustrated background. One of: none | openai | replicate
ADFORGE_IMAGE_PROVIDER=none
